<Window x:Class="RoutineHelper.CompilerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="策略编译与配置" Width="760" Height="440" MinWidth="560" MinHeight="320">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox x:Name="PathGroupBox" Header="策略目录" Padding="10">
            <DockPanel>
                <Button x:Name="SelectSilverfishPathButton" DockPanel.Dock="Right" Content="浏览…" Padding="12,4" Margin="10,0,0,0" Click="SelectSilverfishPathButton_Click" />
                <TextBox x:Name="SilverfishPathTextBox" VerticalContentAlignment="Center" Padding="4" />
            </DockPanel>
        </GroupBox>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,12,0,8" Text="选择策略目录后点击“编译并加载”。" TextWrapping="Wrap" />
        <ProgressBar x:Name="CompileProgress" Grid.Row="2" Height="5" Margin="0,0,0,10" />
        <TextBox x:Name="DiagnosticsTextBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" Padding="18,6" Margin="0,0,10,0" />
            <Button x:Name="CompileButton" Content="编译并加载" IsDefault="True" Padding="18,6" Click="Button_Click" />
        </StackPanel>
    </Grid>
</Window>
