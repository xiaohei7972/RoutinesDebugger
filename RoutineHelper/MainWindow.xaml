<windows:Window x:Class="RoutineHelper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:RoutineHelper" xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif" x:Name="MainWindowLayout" Title="策略编辑器" Height="800" Width="1100" AllowDrop="True" xmlns:windows="clr-namespace:System.Windows;assembly=PresentationFramework" Loaded="MainWindowLayout_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="374*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="155" />
                <RowDefinition Height="*" />
                <RowDefinition Height="120" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82.5" />
                    <ColumnDefinition Width="296*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Image Width="82.5" Source="pack://application:,,,/RoutineHelper;component/res/RoutineHelper.png" gif:AnimationBehavior.SourceUri="pack://application:,,,/RoutineHelper;component/res/RoutineHelper.gif" />
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="SelectionLayout" Grid.Row="0" Margin="2">
                        <ComboBox x:Name="RoutineComboBox" IsEnabled="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" VerticalContentAlignment="Center" Margin="0, 0, 35, 0" ToolTipService.ToolTip="可供使用的策略." Height="{Binding ElementName=SelectionLayout, Path=ActualHeight}" SelectionChanged="RoutineComboBox_SelectionChanged" />
                        <Button x:Name="RoutineSelectionButton" IsEnabled="False" Content="编译" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Center" ToolTipService.ToolTip="选择策略目录并重新编译" Width="{Binding ElementName=SelectionLayout, Path=ActualHeight}" Height="{Binding ElementName=SelectionLayout, Path=ActualHeight}" Click="RoutineSelectionButton_Click" />
                    </Grid>
                    <Grid x:Name="RecentTestLayout" Grid.Row="1" Margin="2">
                        <ComboBox x:Name="RecentTestFilesComboBox" IsEnabled="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" VerticalContentAlignment="Center" Margin="0, 0, 35, 0" ToolTipService.ToolTip="最近测试过的牌面文件." Height="{Binding ElementName=SelectionLayout, Path=ActualHeight}" SelectionChanged="RecentTestFilesComboBox_SelectionChanged" />
                        <Button x:Name="RecentTestRefreshButton" IsEnabled="False" Content="⟳" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Center" ToolTipService.ToolTip="刷新最近测试牌面列表." Width="{Binding ElementName=SelectionLayout, Path=ActualHeight}" Height="{Binding ElementName=SelectionLayout, Path=ActualHeight}" Click="RecentTestRefreshButton_Click" />
                    </Grid>
                    <Grid x:Name="TestLayout" Grid.Row="2" Margin="2">
                        <TextBox x:Name="TestPathBox" IsEnabled="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" VerticalContentAlignment="Center" Margin="0, 0, 35, 0" ToolTipService.ToolTip="要使用的目标测试文件." Height="{Binding ElementName=SelectionLayout, Path=ActualHeight}" />
                        <Button x:Name="TestSelectionButton" IsEnabled="False" Content="🔍" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Center" ToolTipService.ToolTip="选择目标测试文件." Width="{Binding ElementName=SelectionLayout, Path=ActualHeight}" Height="{Binding ElementName=SelectionLayout, Path=ActualHeight}" Click="TestSelectionButton_Click" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="2">
                        <Button x:Name="ExecuteButton" Margin="0, 0, 35, 0" Content="测 试 牌 面" IsEnabled="False" Click="ExecuteButton_Click" />
                        <Button x:Name="DeleteLog" Content="🗑" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Center" ToolTipService.ToolTip="清空日志." Width="{Binding ElementName=SelectionLayout, Path=ActualHeight}" Height="{Binding ElementName=SelectionLayout, Path=ActualHeight}" Click="DeleteLogButton_Click" />
                    </Grid>
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Margin="5">
                <TabControl x:Name="ProgramTabControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="Auto" Width="Auto">
                    <TabItem x:Name="PlayfieldVisualizerTab" Header="牌面可视化">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="对 局 信 息" Padding="2" HorizontalContentAlignment="Center" />
                            <Label Grid.Row="2" Grid.Column="0" Content="我 方 场 面" Padding="2" HorizontalContentAlignment="Center" />
                            <Label Grid.Row="2" Grid.ColumnSpan="3" Grid.Column="2" Content="敌 方 场 面" Padding="2" HorizontalContentAlignment="Center" />
                            <Label Grid.Row="0" Grid.Column="2" Content="我 方 手 牌" Padding="2" HorizontalContentAlignment="Center" />
                            <Label Grid.Row="0" Grid.Column="4" Content="我 方 牌 库" Padding="2" HorizontalContentAlignment="Center" />
                            <Label Grid.Row="4" Grid.Column="0" Content="执 行 动 作" Padding="2" HorizontalContentAlignment="Center" />
                            <Label Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Content="其 他 设 置" Padding="2" HorizontalContentAlignment="Center" />
                            <ListBox x:Name="GeneralInfoListBox" Grid.Row="1" Grid.Column="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:InfoItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <Label Padding="2" Content="{Binding Path=Item}" />
                                            <Label Padding="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Content="{Binding Path=Value}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                            <ListBox x:Name="OwnMinionsListBox" Grid.Row="3" Grid.Column="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Padding="2" Content="{Binding Path=Status}" />
                                            <FrameworkElement.ToolTip>
                                                <ToolTip Background="#00FFFFFF" BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                                                        <Image Width="200" Source="{Binding Path=OnlineCardImage}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </FrameworkElement.ToolTip>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                            <ListBox x:Name="EnemyMinionsListBox" Grid.ColumnSpan="3" Grid.Row="3" Grid.Column="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Padding="2" Content="{Binding Path=Status}" />
                                            <FrameworkElement.ToolTip>
                                                <ToolTip Background="#00FFFFFF" BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                                                        <Image Width="200" Source="{Binding Path=OnlineCardImage}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </FrameworkElement.ToolTip>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                            <ListBox x:Name="OwnHandCardListBox" Grid.Row="1" Grid.Column="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Padding="2" Content="{Binding Path=Status}" />
                                            <FrameworkElement.ToolTip>
                                                <ToolTip Background="#00FFFFFF" BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                                                        <Image Width="200" Source="{Binding Path=OnlineCardImage}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </FrameworkElement.ToolTip>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                            <ListBox x:Name="OwnDeckCardListBox" Grid.Row="1" Grid.Column="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Padding="2" Content="{Binding Path=Status}" />
                                            <FrameworkElement.ToolTip>
                                                <ToolTip Background="#00FFFFFF" BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                                                        <Image Width="200" Source="{Binding Path=OnlineCardImage}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </FrameworkElement.ToolTip>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                            <ListBox x:Name="PlayfieldActionListBox" Grid.Row="5" Grid.Column="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ActionItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <Label Padding="2" Content="{Binding Path=Action}" />
                                            <FrameworkElement.ToolTip>
                                                <ToolTip Background="#00FFFFFF" BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                                                        <Image Width="200" Source="{Binding Path=Source}" />
                                                        <Image Width="200" Source="{Binding Path=Target}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </FrameworkElement.ToolTip>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                            <Grid x:Name="OtherPlayfieldSettingLayout" Grid.Row="5" Grid.Column="2" Margin="5" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Label Padding="2" Grid.Row="0" Grid.Column="0" Content="局面显示:" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
                                <ComboBox x:Name="PlayfieldStepComboBox" Grid.Row="0" Grid.Column="1" SelectionChanged="PlayfieldStepComboBox_SelectionChanged" />
                                <Label Padding="2" Grid.Row="1" Grid.Column="0" Content="策略评分:" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
                                <Label x:Name="PlayfieldScoreLabel" Padding="2" Grid.Row="1" Grid.Column="1" Content="0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" />
                                <TextBox x:Name="PlayfieldSerializedTextBox" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Width="{Binding ElementName=OtherPlayfieldSettingLayout, Path=ActualWidth}" />
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="动作树">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="25" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.ColumnSpan="1" Padding="2" Margin="1" VerticalContentAlignment="Center" Content="动作树：" />
                            <Label Grid.Row="0" Grid.ColumnSpan="1" Padding="2" Margin="1" VerticalContentAlignment="Center" Grid.Column="1" Content="局面评分：" />
                            <Label Grid.Row="0" Grid.ColumnSpan="1" Padding="2" Margin="1" VerticalContentAlignment="Center" Grid.Column="2" HorizontalContentAlignment="Right" Content="{Binding BestScore}" />
                            <Label Grid.Row="2" Grid.ColumnSpan="1" Padding="2" Margin="1" VerticalContentAlignment="Center" Grid.Column="1" Content="选项：" />
                            <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.ColumnSpan="1" Margin="1" Padding="2" Grid.Column="0" Content="高亮路径：" />
                                <ComboBox x:Name="ActionScoreComboBox" Grid.Row="0" Grid.Column="1" Margin="1" Padding="2" SelectionChanged="ActionScoreComboBox_SelectionChanged" />
                            </Grid>
                            <TreeView x:Name="ActionTreeView" Grid.Column="0" Grid.Row="1" Margin="5" Grid.RowSpan="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Stretch">
                                <FrameworkElement.Resources>
                                    <ResourceDictionary>
                                        <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type local:ActionItem}}" DataType="{x:Type local:ActionItem}" ItemsSource="{Binding Items}">
                                            <StackPanel Orientation="Horizontal">
                                                <Label Padding="2" Content="{Binding Path=Score}" Foreground="{Binding Path=Decision}" />
                                                <Label Padding="2" Content="{Binding Path=Action}" Foreground="{Binding Path=Decision}" />
                                                <!--未知连接 ID: 27-->
                                                <Button x:Name="VisualizePlayfieldButton" Content="查看" BorderBrush="#00FFFFFF" Background="#00FFFFFF" VerticalAlignment="Center" Tag="{Binding}" />
                                                <FrameworkElement.ToolTip>
                                                    <ToolTip Background="#00FFFFFF" BorderThickness="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Width="200" Source="{Binding Path=Source}" />
                                                            <Image Width="200" Source="{Binding Path=Target}" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </FrameworkElement.ToolTip>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black" />
                                    </ResourceDictionary>
                                </FrameworkElement.Resources>
                            </TreeView>
                            <ListBox x:Name="BestActionListBox" Margin="5" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ActionItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <Label Padding="2" Content="{Binding Path=Action}" />
                                            <FrameworkElement.ToolTip>
                                                <ToolTip Background="#00FFFFFF" BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                                                        <Image Width="200" Source="{Binding Path=Source}" />
                                                        <Image Width="200" Source="{Binding Path=Target}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </FrameworkElement.ToolTip>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="牌面导出">
                        <Grid Margin="25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ExportPathBox" Margin="5" Height="25" Grid.Row="0" Grid.Column="0" IsEnabled="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTipService.ToolTip="要导出数据的目标文件夹." />
                            <Button x:Name="ExportSelectionButton" Grid.Row="0" Grid.Column="2" Margin="5" HorizontalAlignment="Stretch" IsEnabled="False" Content="🔍" VerticalAlignment="Stretch" ToolTipService.ToolTip="选择导出目标文件夹。" Click="ExportSelectionButton_Click" />
                            <Button x:Name="GenerateButton" Grid.Row="1" Grid.ColumnSpan="3" Margin="5" Content="导 出 数 据" IsEnabled="False" Click="GenerateButton_Click" />
                            <Button x:Name="ExportCardButton" Grid.Row="2" Grid.ColumnSpan="3" Margin="5" Content="导 出 卡 牌" IsEnabled="True" Click="ExportCardButton_Click" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="实体快照">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Label x:Name="EntitySnapshotStatusLabel" Grid.Row="0" Padding="2" Content="当前牌面文件没有实体快照。" />
                            <TextBox x:Name="EntitySnapshotTextBox" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="AI修伏笔">
                        <Grid Margin="12">
                            <FrameworkElement.Resources>
                                <ResourceDictionary>
                                    <Style x:Key="InteractiveEntityContainerStyle" TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Background" Value="#00FFFFFF" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="UIElement.AllowDrop" Value="True" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                                        <Style.Triggers>
                                            <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                                <Setter Property="Background" Value="#00FFFFFF" />
                                            </Trigger>
                                            <DataTrigger Value="False" Binding="{Binding IsSelectable}">
                                                <Setter Property="UIElement.Opacity" Value="0.25" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <DataTemplate x:Key="InteractiveEntityCardTemplate" DataType="{x:Type local:InteractiveEntityItem}">
                                        <Border x:Name="CardFrame" Width="92" Height="128" Margin="4,2" CornerRadius="6" BorderThickness="2" BorderBrush="#22000000" Background="#0A000000">
                                            <Grid>
                                                <Image Stretch="UniformToFill" Source="{Binding OnlineCardImage}" />
                                                <Border Background="#99000000" VerticalAlignment="Bottom" Padding="4">
                                                    <TextBlock Foreground="#FFFFFFFF" FontSize="11" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Text="{Binding PrimaryText}" />
                                                </Border>
                                            </Grid>
                                            <FrameworkElement.ToolTip>
                                                <ToolTip Background="#00FFFFFF" BorderThickness="0">
                                                    <StackPanel Background="#00FFFFFF">
                                                        <TextBlock Foreground="#FFFFFFFF" Background="#BB000000" Padding="6" TextWrapping="Wrap" Text="{Binding Status}" />
                                                        <Image Width="240" Source="{Binding OnlineCardImage}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </FrameworkElement.ToolTip>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Value="True" Binding="{Binding IsCandidateSource}">
                                                <Setter TargetName="CardFrame" Property="Border.BorderBrush" Value="#FF4A90E2" />
                                            </DataTrigger>
                                            <DataTrigger Value="True" Binding="{Binding IsCandidateTarget}">
                                                <Setter TargetName="CardFrame" Property="Border.BorderBrush" Value="#FFF5A623" />
                                            </DataTrigger>
                                            <DataTrigger Value="True" Binding="{Binding IsSelectedAsSource}">
                                                <Setter TargetName="CardFrame" Property="Border.BorderBrush" Value="#FF50E3C2" />
                                                <Setter TargetName="CardFrame" Property="Border.BorderThickness" Value="3" />
                                            </DataTrigger>
                                            <DataTrigger Value="True" Binding="{Binding IsSelectedAsTarget}">
                                                <Setter TargetName="CardFrame" Property="Border.BorderBrush" Value="#FFD0021B" />
                                                <Setter TargetName="CardFrame" Property="Border.BorderThickness" Value="3" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                    <DataTemplate x:Key="InteractiveCandidateCompactTemplate" DataType="{x:Type local:InteractiveCandidateItem}">
                                        <Border Padding="6" Margin="0,0,0,6" CornerRadius="4" BorderThickness="1" BorderBrush="#22000000" Background="#08FFFFFF">
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding Action}" />
                                                <TextBlock FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" Text="{Binding Source}" />
                                                <TextBlock FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" Text="{Binding Target}" />
                                            </StackPanel>
                                            <FrameworkElement.ToolTip>
                                                <ToolTip Background="#00FFFFFF" BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                                                        <Image Width="200" Source="{Binding SourceImage}" />
                                                        <Image Width="200" Source="{Binding TargetImage}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </FrameworkElement.ToolTip>
                                        </Border>
                                    </DataTemplate>
                                </ResourceDictionary>
                            </FrameworkElement.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Label x:Name="AiFixStatusLabel" Grid.Column="0" Padding="2" VerticalContentAlignment="Center" Content="选择牌面后可生成 AI 修伏笔提示词。" />
                                <Button x:Name="GenerateAiFixPromptButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,4" Content="生成提示词" Click="GenerateAiFixPromptButton_Click" />
                                <Button x:Name="CopyAiFixPromptButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,4" Content="复制提示词" Click="CopyAiFixPromptButton_Click" />
                                <Button x:Name="OpenBehaviorSourceButton" Grid.Column="3" Margin="8,0,0,0" Padding="12,4" Content="打开策略源码" Click="OpenBehaviorSourceButton_Click" />
                            </Grid>
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" Text="会自动整理当前测试用例、参考答案、编辑器生成的结果/细节日志、策略源码和实体快照。下面还可以按当前回合做交互式手动选步，补充你期望的打法。" />
                            <ContentControl x:Name="AiFixInteractiveHost" Grid.Row="2" Margin="0,10,0,0">
                                <Grid x:Name="AiFixInteractiveRoot">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="InteractiveAiFixStatusLabel" Grid.Column="0" Padding="2" VerticalContentAlignment="Center" Content="点击“加载当前回合”后开始交互。" />
                                        <Button x:Name="LoadInteractiveAiFixButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,4" Content="加载当前回合" Click="LoadInteractiveAiFixButton_Click" />
                                        <Button x:Name="ApplyInteractiveCandidateButton" Grid.Column="2" Margin="8,0,0,0" Padding="10,4" Content="应用选中动作" Click="ApplyInteractiveCandidateButton_Click" />
                                        <Button x:Name="UndoInteractiveActionButton" Grid.Column="3" Margin="8,0,0,0" Padding="10,4" Content="回退一步" Click="UndoInteractiveActionButton_Click" />
                                        <Button x:Name="ResetInteractiveActionButton" Grid.Column="4" Margin="8,0,0,0" Padding="10,4" Content="重置" Click="ResetInteractiveActionButton_Click" />
                                        <Button x:Name="PopoutInteractiveAiFixButton" Grid.Column="5" Margin="8,0,0,0" Padding="10,4" Content="新窗口" Click="PopoutInteractiveAiFixButton_Click" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="当前牌面（点来源后高亮可点目标）" FontWeight="Bold" />
                                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="1.4*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="1.4*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="1*" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="AiFixHeroPowerCard" Grid.Column="0" Width="92" Height="128" Margin="0,0,10,0" CornerRadius="6" BorderThickness="2" BorderBrush="#22000000" Background="#0A000000" ToolTip="点击可直接使用无目标技能；需要目标时可拖到目标上。" PreviewMouseLeftButtonDown="AiFixHeroPowerCard_PreviewMouseLeftButtonDown" MouseLeftButtonUp="AiFixHeroPowerCard_MouseLeftButtonUp" MouseMove="AiFixHeroPowerCard_MouseMove">
                                                        <Grid>
                                                            <Image x:Name="AiFixHeroPowerImage" Stretch="UniformToFill" />
                                                            <Border Background="#99000000" VerticalAlignment="Bottom" Padding="4">
                                                                <TextBlock x:Name="AiFixHeroPowerNameTextBlock" Text="英雄技能" Foreground="#FFFFFFFF" FontSize="11" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Button x:Name="AiFixEndTurnButton" Grid.Column="1" Width="92" Height="40" VerticalAlignment="Top" Content="结束回合" Click="AiFixEndTurnButton_Click" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.75" Text="拖拽：手牌/我方随从/我方英雄/英雄技能 -&gt; 目标。无目标法术可直接拖到我方场面区域。" />
                                                </Grid>
                                                <Label Grid.Row="1" Content="敌方场面/英雄（目标）" Padding="2" />
                                                <ListBox x:Name="AiFixEnemyBoardListBox" Grid.Row="2" Margin="0,4,0,10" Background="#00FFFFFF" BorderThickness="0" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" ItemTemplate="{StaticResource InteractiveEntityCardTemplate}" DragOver="InteractiveEntityZone_DragOver" Drop="InteractiveEntityZone_Drop" SelectionChanged="InteractiveEntityListBox_SelectionChanged">
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style BasedOn="{StaticResource InteractiveEntityContainerStyle}" TargetType="{x:Type ListBoxItem}">
                                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="InteractiveEntityCard_PreviewMouseLeftButtonDown" />
                                                            <EventSetter Event="MouseMove" Handler="InteractiveEntityCard_MouseMove" />
                                                            <EventSetter Event="DragOver" Handler="InteractiveEntityCard_DragOver" />
                                                            <EventSetter Event="Drop" Handler="InteractiveEntityCard_Drop" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ListBox>
                                                <Label Grid.Row="3" Content="我方场面/英雄（来源/目标）" Padding="2" />
                                                <ListBox x:Name="AiFixOwnBoardListBox" Grid.Row="4" Margin="0,4,0,10" Background="#00FFFFFF" BorderThickness="0" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" ItemTemplate="{StaticResource InteractiveEntityCardTemplate}" DragOver="InteractiveEntityZone_DragOver" Drop="InteractiveEntityZone_Drop" SelectionChanged="InteractiveEntityListBox_SelectionChanged">
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style BasedOn="{StaticResource InteractiveEntityContainerStyle}" TargetType="{x:Type ListBoxItem}">
                                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="InteractiveEntityCard_PreviewMouseLeftButtonDown" />
                                                            <EventSetter Event="MouseMove" Handler="InteractiveEntityCard_MouseMove" />
                                                            <EventSetter Event="DragOver" Handler="InteractiveEntityCard_DragOver" />
                                                            <EventSetter Event="Drop" Handler="InteractiveEntityCard_Drop" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ListBox>
                                                <Label Grid.Row="5" Content="我方手牌（来源）" Padding="2" />
                                                <ListBox x:Name="AiFixOwnHandListBox" Grid.Row="6" Margin="0,4,0,0" Background="#00FFFFFF" BorderThickness="0" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" ItemTemplate="{StaticResource InteractiveEntityCardTemplate}" DragOver="InteractiveEntityZone_DragOver" Drop="InteractiveEntityZone_Drop" SelectionChanged="InteractiveEntityListBox_SelectionChanged">
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style BasedOn="{StaticResource InteractiveEntityContainerStyle}" TargetType="{x:Type ListBoxItem}">
                                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="InteractiveEntityCard_PreviewMouseLeftButtonDown" />
                                                            <EventSetter Event="MouseMove" Handler="InteractiveEntityCard_MouseMove" />
                                                            <EventSetter Event="DragOver" Handler="InteractiveEntityCard_DragOver" />
                                                            <EventSetter Event="Drop" Handler="InteractiveEntityCard_Drop" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ListBox>
                                            </Grid>
                                        </Grid>
                                        <GridSplitter Grid.Column="1" Width="8" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#1A000000" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" />
                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="2*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="1*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="候选动作" FontWeight="Bold" />
                                            <ListBox x:Name="AiFixCandidateActionListBox" Grid.Row="1" Margin="0,6,0,0" ItemTemplate="{StaticResource InteractiveCandidateCompactTemplate}" MouseDoubleClick="AiFixCandidateActionListBox_MouseDoubleClick" SelectionChanged="InteractiveCandidateActionListBox_SelectionChanged" />
                                            <Label Grid.Row="2" Content="选中动作变化" Padding="2" />
                                            <TextBox x:Name="AiFixActionChangeTextBox" Grid.Row="3" Margin="0,4,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                        </Grid>
                                        <GridSplitter Grid.Column="3" Width="8" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#1A000000" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" />
                                        <Grid Grid.Column="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="2*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="1*" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="手动动作路径" FontWeight="Bold" />
                                                <Button x:Name="CopyManualActionButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,2" Content="复制动作" Click="CopyManualActionButton_Click" />
                                            </Grid>
                                            <ListBox x:Name="AiFixManualActionListBox" Grid.Row="1" Margin="0,6,0,0" SelectionChanged="InteractiveManualActionListBox_SelectionChanged">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:ManualActionStep}">
                                                        <StackPanel Margin="0,0,0,6">
                                                            <Label Padding="2" Content="{Binding Title}" />
                                                            <TextBlock Margin="4,0,4,0" TextWrapping="Wrap" Text="{Binding Action}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ListBox>
                                            <Label Grid.Row="2" Content="生成的动作序列" Padding="2" />
                                            <TextBox x:Name="AiFixManualActionScriptTextBox" Grid.Row="3" Margin="0,4,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </ContentControl>
                            <TextBlock Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Text="提示：先点我方手牌/我方场面选择来源，再点己方或敌方场面选择目标，候选动作会自动收敛；应用动作后会推进到下一步，并把你的手动打法一起带进 AI 修伏笔提示词。" />
                            <Expander Grid.Row="4" Margin="0,8,0,0" Header="提示词（展开后可复制给外部 AI）" IsExpanded="False">
                                <TextBox x:Name="AiFixPromptTextBox" Height="220" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                            </Expander>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
            <GridSplitter x:Name="gridSplitter_0" Background="#FF808080" ResizeDirection="Rows" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Top" ResizeBehavior="PreviousAndNext" Height="1" MaxHeight="1" Grid.ColumnSpan="2" Margin="0,0,0.2,0" Grid.RowSpan="2" />
            <Grid Grid.Row="2" Margin="5">
                <Border BorderBrush="#FF808080" BorderThickness="1">
                    <ScrollViewer Name="LogScrollViewer">
                        <RichTextBox x:Name="LogRichTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                            <FlowDocument>
                                <Paragraph />
                            </FlowDocument>
                        </RichTextBox>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="SidePanelLayout" Grid.Column="1">
            <Grid Margin="5,5,5,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="90*" />
                    <RowDefinition Height="29" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBox x:Name="CardListSearchBox" IsEnabled="False" Margin="0,0,40,0" FontSize="14" VerticalContentAlignment="Center" Height="30" InputMethod.IsInputMethodEnabled="True" MaxLines="1" ContextMenu="{x:Null}" KeyDown="CardListSearchBox_KeyDown" />
                    <Label Content="🔍" VerticalContentAlignment="Center" HorizontalAlignment="Right" FontSize="18" />
                </Grid>
                <Grid Grid.Row="1" />
                <Grid x:Name="SidePanelCardListBoxLayout" Grid.Row="2">
                    <ListBox x:Name="CardListBox" HorizontalContentAlignment="Left" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Width="{Binding ElementName=SidePanelCardListBoxLayout, Path=ActualWidth}" Height="{Binding ElementName=SidePanelCardListBoxLayout, Path=ActualHeight}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Label Width="14" Foreground="#FFFFFFFF" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" HorizontalAlignment="Left" FontSize="8" Content="{Binding Path=cost}" Background="{Binding Path=Color}" />
                                    <Label Foreground="#FF000000" Width="92" FontSize="10" Content="{Binding Path=cardIdText}" />
                                    <Label Foreground="#FF000000" Width="120" FontSize="12" Content="{Binding Path=nameCN}">
                                        <FrameworkElement.ToolTip>
                                            <ToolTip Background="#00FFFFFF" BorderThickness="0">
                                                <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                                                    <Image Width="200" Source="{Binding Path=OnlineCardImage}" />
                                                </StackPanel>
                                            </ToolTip>
                                        </FrameworkElement.ToolTip>
                                    </Label>
                                    <Label Foreground="#FF000000" Width="72" FontSize="10" Content="{Binding Path=dbfId}" />
                                    <!--未知连接 ID: 70-->
                                    <Button x:Name="CopyCardButton" Content="📝" ToolTip="复制卡牌 ID" Width="20" IsEnabled="True" Margin="0 0 5 0" Tag="{Binding}" />
                                    <!--未知连接 ID: 71-->
                                    <Button x:Name="CheckCardButton" Content="🔍" ToolTip="检查卡牌 Sim 文件" Width="20" IsEnabled="True" Margin="0 0 5 0" Tag="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ListBox>
                </Grid>
                <Grid x:Name="SidePanelStatusBarLayout" Grid.Row="3">
                    <Label x:Name="CardSearchStatusBar" HorizontalAlignment="Left" VerticalContentAlignment="Center" VerticalAlignment="Top" Height="{Binding ElementName=SidePanelStatusBarLayout, Path=ActualHeight}" Width="{Binding ElementName=SidePanelStatusBarLayout, Path=ActualWidth}" />
                    <Button x:Name="SettingsButton" Content="⚙" HorizontalAlignment="Right" Margin="5,5,0,5" Width="{Binding ElementName=SettingsButton, Path=ActualHeight}" Click="SettingsButton_Click" />
                </Grid>
            </Grid>
            <GridSplitter HorizontalAlignment="Left" VerticalAlignment="Top" Width="1" Background="#FF808080" Foreground="#FF808080" Height="{Binding ElementName=MainWindowLayout, Path=ActualHeight}" />
        </Grid>
    </Grid>
</windows:Window>
